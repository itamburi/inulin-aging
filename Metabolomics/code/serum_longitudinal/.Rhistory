here::i_am("code/serum_longitudinal/01_process_serum_longitudinal_metabolomics.R")
source(here::here("code/z-source.R"))
raw_cd_dir = here::here("data/raw/serum_longitudinal/compound discoverer")
raw_maven_dir = here::here("data/raw/serum_longitudinal/maven")
processed_dir = here::here("data/processed/serum_longitudinal/ion_counts")
cd_csv_dir = here::here("data/processed/serum_longitudinal/ion_counts/compound_discoverer_csv")
maven_merger_dir = here::here("data/processed/serum_longitudinal/ion_counts/maven_merger")
dir.create(processed_dir, recursive = TRUE, showWarnings = FALSE)
dir.create(cd_csv_dir, recursive = TRUE, showWarnings = FALSE)
dir.create(maven_merger_dir, recursive = TRUE, showWarnings = FALSE)
# Parse positive/negative ion mode from CD filenames or serum sequence IDs.
get_serum_longitudinal_ion_mode_from_text <- function(x) {
dplyr::case_when(
grepl("positive|\\bpos\\b|(?:^|_)pos(?:_|$)", x, ignore.case = TRUE, perl = TRUE) ~ "posi",
grepl("negative|\\bneg\\b|(?:^|_)neg(?:2)?(?:_|$)", x, ignore.case = TRUE, perl = TRUE) ~ "nega",
TRUE ~ NA_character_
)
}
# Remove CD/Maven suffixes so reruns and timestamped injections share one ID.
normalize_serum_longitudinal_sequence_id <- function(sequence_id) {
sequence_id %>%
stringr::str_remove("\\.raw.*$") %>%
stringr::str_replace("_+$", "") %>%
stringr::str_replace(
"(_(?:pos|neg))(?:_(?:rerun|resume)[0-9]*|_[0-9]{8,})+$",
"\\1"
) %>%
stringr::str_replace("_+$", "")
}
# Extract the mouse sample ID, such as 3M21, from a sequence ID.
get_serum_longitudinal_sample <- function(sequence_id) {
stringr::str_extract(sequence_id, "^[1-5]M\\d+")
}
# Extract the longitudinal serum collection timepoint encoded in the sequence ID.
get_serum_longitudinal_timepoint <- function(sequence_id) {
sample = get_serum_longitudinal_sample(sequence_id)
dplyr::case_when(
grepl("_mid_", sequence_id, ignore.case = TRUE) ~ "mid",
grepl("_old_", sequence_id, ignore.case = TRUE) ~ "old",
grepl("^5M\\d+_(?:pos|neg)$", sequence_id, ignore.case = TRUE, perl = TRUE) ~ "young",
grepl("^5M", sample, ignore.case = TRUE) ~ "young",
TRUE ~ NA_character_
)
}
# Extract numeric cohort from the mouse sample ID.
get_serum_longitudinal_cohort <- function(sample) {
stringr::str_extract(sample, "^\\d+")
}
# Prefer CD Group Area columns for sample ion counts; fall back to Area columns only if needed.
get_serum_longitudinal_cd_sample_cols <- function(col_names) {
group_area_cols = col_names[
grepl("^Group Area: ", col_names) &
!grepl("blank|STD", col_names, ignore.case = TRUE)
]
if (length(group_area_cols) > 0) {
return(group_area_cols)
}
col_names[
grepl("^Area: ", col_names) &
col_names != "Area (Max.)" &
!grepl("blank|STD", col_names, ignore.case = TRUE)
]
}
# Convert a CD measurement column name into the normalized sequence ID.
clean_serum_longitudinal_cd_sequence_id <- function(col_name) {
col_name %>%
stringr::str_remove("^Group Area: ") %>%
stringr::str_remove("^Area: ") %>%
normalize_serum_longitudinal_sequence_id()
}
# Select Maven sample columns while excluding blanks and standards.
get_serum_longitudinal_maven_sample_cols <- function(col_names) {
col_names[
grepl(
"^[1-5]M\\d+(?:_(?:mid|old))?_(?:pos|neg)(?:_(?:rerun|resume)[0-9]*|_[0-9]{8,})?$",
col_names,
ignore.case = TRUE,
perl = TRUE
) &
!grepl("blank|STD", col_names, ignore.case = TRUE)
]
}
# Standardize Maven compound names, especially labeled internal standards.
normalize_serum_longitudinal_maven_compound_name <- function(compound, isotope_label) {
compound_clean = stringr::str_squish(compound)
compound_lower = tolower(compound_clean)
dplyr::case_when(
compound_lower %in% c("valine", "l-valine", "m37_valine") &
isotope_label == "C13N15-label-5-1" ~ "Valine-C13N15",
compound_lower %in% c("phenylalanine", "l-phenylalanine") &
isotope_label == "D2-label-8" ~ "Phenylalanine-D2",
compound_lower == "inosine" &
isotope_label == "N15-label-4" ~ "Inosine-N15",
compound_lower %in% c("valine", "l-valine", "m37_valine") ~ "Valine",
compound_lower %in% c("phenylalanine", "l-phenylalanine") ~ "Phenylalanine",
TRUE ~ compound_clean
)
}
# Longitudinal Maven files name the negative and positive mode internal standards separately.
get_serum_longitudinal_internal_standard <- function(ion_mode) {
dplyr::case_when(
ion_mode == "nega" ~ "Valine-C13N15",
ion_mode == "posi" ~ "Phenylalanine-D2",
TRUE ~ NA_character_
)
}
CD_files = list.files(raw_cd_dir, pattern = "\\.xlsx$", full.names = TRUE)
CD_files
for (CD_file in CD_files) {
file_name = tools::file_path_sans_ext(basename(CD_file))
data = readxl::read_xlsx(CD_file) %>%
select(-starts_with("Peak Rating:"))
csv_file = file.path(cd_csv_dir, paste0(file_name, ".csv"))
write.csv(data, csv_file, row.names = FALSE)
cat("Converted", CD_file, "to", csv_file, "\n")
}
csv_files = list.files(cd_csv_dir, pattern = "\\.csv$", full.names = TRUE)
csv_data_list = list()
for (csv_file in csv_files) {
csv_data = read.csv(csv_file, check.names = FALSE)
csv_data_list[[csv_file]] = csv_data
}
tidy_df_list <- function(filename) {
cd_df = csv_data_list[[filename]]
file_label = basename(filename)
measurement_cols = get_serum_longitudinal_cd_sample_cols(names(cd_df))
if (length(measurement_cols) == 0) {
stop(paste0("No serum longitudinal ion-count columns found for file: ", file_label), call. = FALSE)
}
cleaned_sequence_ids = clean_serum_longitudinal_cd_sequence_id(measurement_cols)
id_cols = intersect(
c(
"Name", "Formula", "Calc. MW", "m/z", "RT [min]",
"Annot. Source: mzCloud Search", "Annot. Source: MassList Search",
"mzCloud Best Match Confidence", "Annot. DeltaMass [ppm]"
),
names(cd_df)
)
tidy = cd_df %>%
select(all_of(c(id_cols, measurement_cols)))
names(tidy) = dplyr::recode(
names(tidy),
"Calc. MW" = "calc.mw",
"m/z" = "mz",
"RT [min]" = "rt.min",
"Annot. Source: mzCloud Search" = "annot.source.mzcloud",
"Annot. Source: MassList Search" = "annot.source.masslist",
"mzCloud Best Match Confidence" = "mzcloud.conf",
"Annot. DeltaMass [ppm]" = "delta.mass.ppm",
.default = names(tidy)
)
tidy = tidy %>%
pivot_longer(
cols = all_of(measurement_cols),
names_to = "sequence.id",
values_to = "ion.count"
) %>%
mutate(
sequence.id = cleaned_sequence_ids[match(sequence.id, measurement_cols)],
Formula = gsub(" ", "", Formula),
raw.file = file_label
) %>%
rename_with(tolower) %>%
mutate(
ion.count = as.numeric(ion.count),
mz = as.numeric(mz),
rt.min = as.numeric(rt.min),
delta.mass.ppm = as.numeric(delta.mass.ppm),
mzcloud.conf = as.numeric(mzcloud.conf)
)
print(paste0("Completed ", filename))
return(tidy)
}
tidy_list = lapply(names(csv_data_list), tidy_df_list)
tidy_df = bind_rows(tidy_list)
View(tidy_df)
unique(tidy_df$sequence.id)
here::i_am("code/integrative/01_cytokine_metabolite_correlations.R")
# ========== 0.0 - Environment ==========
# --
library(dplyr)
library(tidyr)
library(readr)
library(purrr)
dir.create(here::here("data/processed/integrative/cytokine_metabolite_correlations"), recursive = TRUE, showWarnings = FALSE)
# ========== 1.0 - Read processed cytokine and metabolite data ==========
# --
metabolite_data = readr::read_csv(
here::here("data/processed/tissue_metabolomics/cohort_comparisons/all group sample-level median adjusted ion counts.csv"),
show_col_types = FALSE,
na = c("", "NA", "N/A")
) %>%
rename(
sample = sample.clean,
metabolite = name,
metabolite_tissue = tissue,
metabolite_abundance = med.adj.ic
) %>%
select(
sample, metabolite_tissue, metabolite,
metabolite_abundance, metabolite_n_obs = n_obs,
metabolite_group = group, metabolite_cohort = cohort,
metabolite_age = age, metabolite_diet = diet,
metabolite_animal = animal
)
